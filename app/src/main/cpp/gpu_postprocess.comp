#version 450

// 128-thread workgroups (two Adreno wavefronts) hide more memory-fetch latency
// than the original 8x8=64. Mali lane-64 GPUs also benefit: one 64-lane wave
// remains but the second "wave" of 64 overlaps its own memory latency with
// the first. No visual impact — the math is identical.
layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;

layout(rgba8, set = 0, binding = 0) readonly uniform image2D srcImg;
layout(rgba8, set = 0, binding = 1) writeonly uniform image2D dstImg;

layout(push_constant) uniform Params {
    int srcW;
    int srcH;
    int dstW;
    int dstH;
    int method;
    float sharpness;
    float strength;
    float pad0;
} pc;

// ---- Shared-memory tile ---------------------------------------------------
//
// When source and destination have identical dimensions (the overwhelmingly
// common case — gpuUpscaleFactor defaults to 1.0, only occasionally bumped
// to ~1.5x-2x), each workgroup's 16x8 destination footprint maps to the same
// 16x8 source region plus a 3-pixel halo on each side for Lanczos 6x6. That
// fits in a 22x14 = 308-pixel tile (4928 bytes), a small fraction of the
// 32 KB groupshared limit on every mainstream mobile GPU.
//
// For upscale factors between 1.0 and 1.5 the workgroup footprint in source
// shrinks, so the same tile dimensions still cover the full needed range.
// For larger scale factors (or downscale) we fall back to direct imageLoad.
// Workgroup size + Lanczos halo. Kept as literals because GLSL rejects
// global `const int`s derived from `gl_WorkGroupSize` — the values are
// constant-folded via the layout declaration, not via a dynamic query.
#define TILE_HALO 3                  // Lanczos 6x6 needs 2.5px / side -> 3
#define TILE_W    (16 + 2 * TILE_HALO)  // = 22
#define TILE_H    ( 8 + 2 * TILE_HALO)  // = 14

shared vec4 tile[TILE_W * TILE_H];
// Workgroup-uniform state derived from push constants + workgroup ID. We
// stash it in shared memory rather than recomputing per invocation so the
// compiler treats it as uniform across the wave (useful for branch
// coherency in loadPx).
shared bool  s_useTile;
shared ivec2 s_tileOrigin;

vec4 loadPxDirect(ivec2 p) {
    p = clamp(p, ivec2(0), ivec2(pc.srcW - 1, pc.srcH - 1));
    return imageLoad(srcImg, p);
}

vec4 loadPx(ivec2 p) {
    if (s_useTile) {
        ivec2 local = p - s_tileOrigin;
        if (local.x >= 0 && local.y >= 0 && local.x < TILE_W && local.y < TILE_H) {
            return tile[local.y * TILE_W + local.x];
        }
    }
    return loadPxDirect(p);
}

void populateTile(ivec2 workgroupDstBase, vec2 scale) {
    // One thread computes the origin, all consume. memory + exec barrier
    // after population makes every tile write visible.
    if (gl_LocalInvocationIndex == 0u) {
        vec2 baseSrc = (vec2(workgroupDstBase) + vec2(0.5)) * scale - vec2(0.5);
        s_tileOrigin = ivec2(floor(baseSrc)) - ivec2(TILE_HALO);
    }
    barrier();
    memoryBarrierShared();

    // Cooperative fill: 128 threads load TILE_W * TILE_H = 308 pixels in
    // ceil(308 / 128) = 3 passes.
    const int WG    = 16 * 8;
    const int TOTAL = TILE_W * TILE_H;
    int tid = int(gl_LocalInvocationIndex);
    for (int i = tid; i < TOTAL; i += WG) {
        int lx = i % TILE_W;
        int ly = i / TILE_W;
        ivec2 srcPx = s_tileOrigin + ivec2(lx, ly);
        srcPx = clamp(srcPx, ivec2(0), ivec2(pc.srcW - 1, pc.srcH - 1));
        tile[i] = imageLoad(srcImg, srcPx);
    }
    barrier();
    memoryBarrierShared();
}

// ---- Reconstruction kernels ----------------------------------------------

float cubicWeight(float x) {
    x = abs(x);
    float x2 = x * x;
    float x3 = x2 * x;
    if (x <= 1.0) return 1.5 * x3 - 2.5 * x2 + 1.0;
    if (x < 2.0) return -0.5 * x3 + 2.5 * x2 - 4.0 * x + 2.0;
    return 0.0;
}

float sinc(float x) {
    x = abs(x);
    if (x < 0.0001) return 1.0;
    float pix = 3.14159265 * x;
    return sin(pix) / pix;
}

float lanczosWeight(float x) {
    x = abs(x);
    if (x >= 3.0) return 0.0;
    return sinc(x) * sinc(x / 3.0);
}

vec4 sampleBilinear(vec2 srcPos) {
    vec2 p = srcPos - vec2(0.5);
    ivec2 p0 = ivec2(floor(p));
    vec2 f = fract(p);
    vec4 a = loadPx(p0);
    vec4 b = loadPx(p0 + ivec2(1, 0));
    vec4 c = loadPx(p0 + ivec2(0, 1));
    vec4 d = loadPx(p0 + ivec2(1, 1));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

vec4 sampleBicubic(vec2 srcPos) {
    vec2 p = srcPos - vec2(0.5);
    ivec2 base = ivec2(floor(p)) - ivec2(1);
    vec2 f = fract(p);
    vec4 sum = vec4(0.0);
    float total = 0.0;
    for (int y = 0; y < 4; ++y) {
        float wy = cubicWeight(float(y) - 1.0 - f.y);
        for (int x = 0; x < 4; ++x) {
            float wx = cubicWeight(float(x) - 1.0 - f.x);
            float w = wx * wy;
            sum += loadPx(base + ivec2(x, y)) * w;
            total += w;
        }
    }
    return sum / max(total, 0.0001);
}

vec4 sampleLanczos(vec2 srcPos) {
    vec2 p = srcPos - vec2(0.5);
    ivec2 base = ivec2(floor(p)) - ivec2(2);
    vec2 f = fract(p);
    vec4 sum = vec4(0.0);
    float total = 0.0;
    // 6x6 kernel: 36 fetches. With shared-memory tiling all 36 come from
    // groupshared L1, ~10x faster than the original direct imageLoad path.
    for (int y = 0; y < 6; ++y) {
        float wy = lanczosWeight(float(y) - 2.0 - f.y);
        for (int x = 0; x < 6; ++x) {
            float wx = lanczosWeight(float(x) - 2.0 - f.x);
            float w = wx * wy;
            sum += loadPx(base + ivec2(x, y)) * w;
            total += w;
        }
    }
    return sum / max(total, 0.0001);
}

float luma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

vec4 sampleFsrEasu(vec2 srcPos) {
    vec2 p = srcPos - vec2(0.5);
    ivec2 ip = ivec2(floor(p));
    vec2 fp = fract(p);

    vec3 c00 = loadPx(ip + ivec2(0, 0)).rgb;
    vec3 c10 = loadPx(ip + ivec2(1, 0)).rgb;
    vec3 c01 = loadPx(ip + ivec2(0, 1)).rgb;
    vec3 c11 = loadPx(ip + ivec2(1, 1)).rgb;

    float l00 = luma(c00);
    float l10 = luma(c10);
    float l01 = luma(c01);
    float l11 = luma(c11);
    vec2 dir = vec2((l10 + l11) - (l00 + l01), (l01 + l11) - (l00 + l10));
    float dirLen = max(length(dir), 0.0001);
    dir /= dirLen;

    vec2 ortho = vec2(-dir.y, dir.x);
    float edgeAmount = clamp(dirLen * 3.0, 0.0, 1.0);
    float stretchMajor = mix(1.0, 1.75, edgeAmount);
    float stretchMinor = mix(1.0, 0.55, edgeAmount);

    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int y = -2; y <= 3; ++y) {
        for (int x = -2; x <= 3; ++x) {
            vec2 d = vec2(float(x), float(y)) - fp;
            float along = dot(d, ortho) / stretchMajor;
            float across = dot(d, dir) / stretchMinor;
            float dist2 = along * along + across * across;
            float w = exp2(-1.45 * dist2);
            w *= 1.0 + 0.18 * max(0.0, 1.0 - abs(across));
            sum += loadPx(ip + ivec2(x, y)).rgb * w;
            total += w;
        }
    }

    vec3 bilinear = sampleBilinear(srcPos).rgb;
    vec3 easu = sum / max(total, 0.0001);
    return vec4(mix(bilinear, easu, 0.86), 1.0);
}

vec3 rcasPassAtRadius(vec3 color, ivec2 p, int r, float sharpWeight) {
    vec3 n = loadPx(p + ivec2(0, -r)).rgb;
    vec3 s = loadPx(p + ivec2(0,  r)).rgb;
    vec3 e = loadPx(p + ivec2(r,  0)).rgb;
    vec3 w = loadPx(p + ivec2(-r, 0)).rgb;

    float lC = luma(color);
    float lN = luma(n);
    float lS = luma(s);
    float lE = luma(e);
    float lW = luma(w);

    float mn4 = min(min(lN, lS), min(lE, lW));
    float mx4 = max(max(lN, lS), max(lE, lW));

    float hitMin = min(mn4, lC) / max(4.0 * mx4, 1.0e-4);
    float hitMax = (1.0 - max(mx4, lC)) / min(4.0 * mn4 - 4.0, -1.0e-4);
    float lobe = max(-hitMin, hitMax);

    float localRange = max(mx4, lC) - min(mn4, lC);
    float noiseGate = smoothstep(0.006, 0.030, localRange);

    const float kRcasLimit = 0.215; // Crisp mobile RCAS limit (< 0.25 stability bound)
    float weight = clamp(lobe, -kRcasLimit, 0.0) * sharpWeight * noiseGate;

    vec3 outColor = (weight * (n + s + e + w) + color) / (4.0 * weight + 1.0);
    return clamp(outColor, 0.0, 1.0);
}

vec3 fsrRcas(vec3 color, vec2 srcPos, float sharpness, float strength) {
    ivec2 p = ivec2(floor(srcPos));
    float sharpWeight = clamp(0.55 + 0.45 * sharpness, 0.0, 1.0)
                      * clamp(0.60 + 0.40 * strength,  0.0, 1.0);

    // On high-DPI displays (>=1800px, e.g. 2800x1260 phone screens), 720p/1080p
    // game & video content is already upscaled 2x-3x before MediaProjection
    // captures it, so a 1px tap only sees sub-pixel interpolation ramps.
    // Combining r=2 (primary content edge scale, still inside TILE_HALO=3 L1)
    // with r=1 (fine detail) delivers unmistakable AMD RCAS crispness.
    if (max(pc.dstW, pc.dstH) >= 1800) {
        vec3 coarse = rcasPassAtRadius(color, p, 2, sharpWeight);
        vec3 fine   = rcasPassAtRadius(coarse, p, 1, sharpWeight * 0.65);
        return fine;
    }
    return rcasPassAtRadius(color, p, 1, sharpWeight);
}

vec3 sharpen(vec3 color, vec2 srcPos, float amount) {
    ivec2 p = ivec2(floor(srcPos));
    vec3 n = loadPx(p + ivec2(0, -1)).rgb;
    vec3 s = loadPx(p + ivec2(0, 1)).rgb;
    vec3 e = loadPx(p + ivec2(1, 0)).rgb;
    vec3 w = loadPx(p + ivec2(-1, 0)).rgb;
    vec3 blur = (n + s + e + w) * 0.25;
    return clamp(color + (color - blur) * amount, 0.0, 1.0);
}

vec3 contrastAdaptive(vec3 color, vec2 srcPos, float amount) {
    ivec2 p = ivec2(floor(srcPos));
    vec3 minC = color;
    vec3 maxC = color;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec3 v = loadPx(p + ivec2(x, y)).rgb;
            minC = min(minC, v);
            maxC = max(maxC, v);
        }
    }
    vec3 amp = clamp(maxC - minC, vec3(0.0), vec3(1.0));
    return clamp(color + (color - 0.5) * amp * amount, 0.0, 1.0);
}

vec3 animeEdge(vec3 color, vec2 srcPos, float amount) {
    ivec2 p = ivec2(floor(srcPos));
    vec3 gx = loadPx(p + ivec2(1, 0)).rgb - loadPx(p + ivec2(-1, 0)).rgb;
    vec3 gy = loadPx(p + ivec2(0, 1)).rgb - loadPx(p + ivec2(0, -1)).rgb;
    vec3 edge = abs(gx) + abs(gy);
    return clamp(color + edge * amount, 0.0, 1.0);
}

vec3 deband(vec3 color, vec2 srcPos, float amount) {
    ivec2 p = ivec2(floor(srcPos));
    vec3 avg = vec3(0.0);
    avg += loadPx(p + ivec2(-1, 0)).rgb;
    avg += loadPx(p + ivec2(1, 0)).rgb;
    avg += loadPx(p + ivec2(0, -1)).rgb;
    avg += loadPx(p + ivec2(0, 1)).rgb;
    avg *= 0.25;
    return mix(color, avg, amount * 0.35);
}

// ---- Qualcomm Snapdragon GSR v1 (BSD-3-Clause, Edge-Direction Mobile) -----
// Single-pass 12-tap edge-directed Lanczos2 spatial super resolution &
// sharpening. Vendor-agnostic GLSL compute port reading from shared-memory L1.
float sgsrFastLanczos2(float x) {
    float wA = x - 4.0;
    float wB = x * wA - wA;
    wA *= wA;
    return wB * wA;
}

vec2 sgsrWeightY(float dx, float dy, float c, vec3 data) {
    float stdVal = data.x;
    vec2 dir = data.yz;
    float edgeDis = (dx * dir.y) + (dy * dir.x);
    float x = ((dx * dx) + (dy * dy)) +
              ((edgeDis * edgeDis) * ((clamp((c * c) * stdVal, 0.0, 1.0) * 0.7) - 1.0));
    float w = sgsrFastLanczos2(x);
    return vec2(w, w * c);
}

vec2 sgsrEdgeDirection(vec4 left, vec4 right) {
    float RxLz = right.x - left.z;
    float RwLy = right.w - left.y;
    vec2 delta = vec2(RxLz + RwLy, RxLz - RwLy);
    float lengthInv = inversesqrt((delta.x * delta.x + 3.075740e-05) + (delta.y * delta.y));
    return delta * lengthInv;
}

vec4 applySgsrV1Native(ivec2 ip, float sharpness, float strength) {
    // At 1:1 native resolution on high-DPI displays (>=1800px), game/video
    // frames captured by MediaProjection are already upscaled 2x-3x. Use a
    // resolution-aware tap radius (r=2 on >=1800px, still inside TILE_HALO=3
    // shared memory) for Qualcomm-style edge-directed luma detail restoration:
    // sharpen across detected edges while keeping diagonal lines smooth.
    int r = (max(pc.dstW, pc.dstH) >= 1800) ? 2 : 1;
    vec4 center = loadPx(ip);
    float c  = luma(center.rgb);
    float n  = luma(loadPx(ip + ivec2( 0, -r)).rgb);
    float s  = luma(loadPx(ip + ivec2( 0,  r)).rgb);
    float e  = luma(loadPx(ip + ivec2( r,  0)).rgb);
    float w  = luma(loadPx(ip + ivec2(-r,  0)).rgb);
    float nw = luma(loadPx(ip + ivec2(-r, -r)).rgb);
    float ne = luma(loadPx(ip + ivec2( r, -r)).rgb);
    float sw = luma(loadPx(ip + ivec2(-r,  r)).rgb);
    float se = luma(loadPx(ip + ivec2( r,  r)).rgb);

    float gx = (ne + 2.0 * e + se) - (nw + 2.0 * w + sw);
    float gy = (sw + 2.0 * s + se) - (nw + 2.0 * n + ne);
    float grad2 = gx * gx + gy * gy;

    float avgCross = 0.25 * (n + s + e + w);
    float avgDiag  = 0.25 * (nw + ne + sw + se);
    float localBlur = 0.65 * avgCross + 0.35 * avgDiag;

    // Directional edge-across average: sharpens perpendicular to the edge so
    // diagonal contours stay clean and un-jagged.
    float dirMix = smoothstep(0.001, 0.025, grad2);
    float invLen = inversesqrt(grad2 + 1.0e-5);
    float nx = abs(gx) * invLen;
    float ny = abs(gy) * invLen;
    float acrossAvg = nx * nx * 0.5 * (e + w) + ny * ny * 0.5 * (n + s);
    float refLuma = mix(localBlur, acrossAvg, 0.50 * dirMix);

    float mn = min(c, min(min(n, s), min(e, w)));
    float mx = max(c, max(max(n, s), max(e, w)));
    float contrast = mx - mn;

    // Noise gate tuned for soft upscaled video/TAA content.
    float gate = smoothstep(0.008, 0.032, contrast);
    float gain = (1.35 + 1.65 * sharpness) * (0.65 + 0.55 * strength);
    float deltaY = (c - refLuma) * gain * gate;

    // Anti-ringing clamp proportional to local contrast.
    float maxDelta = min(0.28, contrast * 0.85 + 0.05);
    deltaY = clamp(deltaY, -maxDelta, maxDelta);

    return vec4(clamp(center.rgb + vec3(deltaY), 0.0, 1.0), 1.0);
}

vec4 applySgsrV1(vec2 srcPos, float sharpness, float strength) {
    if (pc.srcW == pc.dstW && pc.srcH == pc.dstH) {
        return applySgsrV1Native(ivec2(floor(srcPos)), sharpness, strength);
    }
    vec4 color = sampleBilinear(srcPos);
    vec2 p = srcPos - vec2(0.5);
    ivec2 ip = ivec2(floor(p));
    vec2 pl = fract(p);

    // Sample green channel (OperationMode = 1) from shared-memory tile.
    vec4 left = vec4(
        loadPx(ip + ivec2(-1, 1)).g,
        loadPx(ip + ivec2( 0, 1)).g,
        loadPx(ip + ivec2( 0, 0)).g,
        loadPx(ip + ivec2(-1, 0)).g
    );

    const float edgeThreshold = 8.0 / 255.0;
    float edgeVote = abs(left.z - left.y) + abs(color.g - left.y) + abs(color.g - left.z);
    if (edgeVote > edgeThreshold) {
        vec4 right = vec4(
            loadPx(ip + ivec2(1, 1)).g,
            loadPx(ip + ivec2(2, 1)).g,
            loadPx(ip + ivec2(2, 0)).g,
            loadPx(ip + ivec2(1, 0)).g
        );
        vec4 upDown = vec4(
            loadPx(ip + ivec2(0, -1)).g,
            loadPx(ip + ivec2(1, -1)).g,
            loadPx(ip + ivec2(1,  2)).g,
            loadPx(ip + ivec2(0,  2)).g
        );

        float mean = (left.y + left.z + right.x + right.w) * 0.25;
        left -= vec4(mean);
        right -= vec4(mean);
        upDown -= vec4(mean);
        float centerY = color.g - mean;

        float sum = (abs(left.x) + abs(left.y) + abs(left.z) + abs(left.w)) +
                    (abs(right.x) + abs(right.y) + abs(right.z) + abs(right.w)) +
                    (abs(upDown.x) + abs(upDown.y) + abs(upDown.z) + abs(upDown.w));
        float sumMean = 1.014185e+01 / max(sum, 1.0e-5);
        float stdVal = sumMean * sumMean;

        vec3 data = vec3(stdVal, sgsrEdgeDirection(left, right));
        vec2 aWY = sgsrWeightY(pl.x,       pl.y + 1.0, upDown.x, data);
        aWY     += sgsrWeightY(pl.x - 1.0, pl.y + 1.0, upDown.y, data);
        aWY     += sgsrWeightY(pl.x - 1.0, pl.y - 2.0, upDown.z, data);
        aWY     += sgsrWeightY(pl.x,       pl.y - 2.0, upDown.w, data);
        aWY     += sgsrWeightY(pl.x + 1.0, pl.y - 1.0, left.x,   data);
        aWY     += sgsrWeightY(pl.x,       pl.y - 1.0, left.y,   data);
        aWY     += sgsrWeightY(pl.x,       pl.y,       left.z,   data);
        aWY     += sgsrWeightY(pl.x + 1.0, pl.y,       left.w,   data);
        aWY     += sgsrWeightY(pl.x - 1.0, pl.y - 1.0, right.x,  data);
        aWY     += sgsrWeightY(pl.x - 2.0, pl.y - 1.0, right.y,  data);
        aWY     += sgsrWeightY(pl.x - 2.0, pl.y,       right.z,  data);
        aWY     += sgsrWeightY(pl.x - 1.0, pl.y,       right.w,  data);

        float finalY = (abs(aWY.x) > 1.0e-5) ? (aWY.y / aWY.x) : centerY;
        float maxY = max(max(left.y, left.z), max(right.x, right.w));
        float minY = min(min(left.y, left.z), min(right.x, right.w));
        float edgeSharpness = 1.0 + 1.5 * sharpness; // default ~2.0 at sharpness=0.65
        float deltaY = clamp(edgeSharpness * finalY, minY, maxY) - centerY;
        deltaY = clamp(deltaY * (0.5 + 0.5 * strength), -23.0 / 255.0, 23.0 / 255.0);

        color.rgb = clamp(color.rgb + vec3(deltaY), 0.0, 1.0);
    }
    color.a = 1.0;
    return color;
}

void main() {
    // Compute the scale factor once per invocation. The tile fast path is
    // valid when the scale is close to 1.0 in both axes — the workgroup's
    // source footprint is then bounded by TILE_W x TILE_H and every sample
    // stays inside the tile. Outside that range we fall back to direct
    // imageLoad, which is identical to the pre-optimization path.
    vec2 scale = vec2(float(pc.srcW) / float(pc.dstW), float(pc.srcH) / float(pc.dstH));

    // Tile fast path: workgroup footprint in source is bounded by the tile
    // dimensions only when scale is ~1 in both axes. Be strict — any scale
    // factor outside [1.0, 1.125] can produce reads beyond TILE_W=22, which
    // would silently return wrong values via loadPxDirect fallback. Covers
    // the overwhelmingly common config (gpuUpscaleFactor=1.0) without
    // risking correctness at higher scale factors.
    if (gl_LocalInvocationIndex == 0u) {
        s_useTile = (pc.srcW == pc.dstW) && (pc.srcH == pc.dstH);
    }
    barrier();
    memoryBarrierShared();

    ivec2 workgroupDstBase = ivec2(gl_WorkGroupID.xy) * ivec2(gl_WorkGroupSize.xy);
    if (s_useTile) {
        populateTile(workgroupDstBase, scale);
    }

    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    if (dst.x >= pc.dstW || dst.y >= pc.dstH) return;

    vec2 srcPos = (vec2(dst) + vec2(0.5)) * scale;
    float sharp = clamp(pc.sharpness, 0.0, 1.0);
    float strength = clamp(pc.strength, 0.0, 1.0);

    if (pc.method == 16) {
        vec4 sgsr = applySgsrV1(srcPos, sharp, strength);
        imageStore(dstImg, dst, clamp(sgsr, 0.0, 1.0));
        return;
    }

    vec4 color;

    if (pc.method == 0) {
        // Official AMD FSR 1 spec: at 1:1 native resolution, skip EASU (which
        // is a spatial upscaler and would blur 1:1 input) and run pure RCAS.
        if (pc.srcW == pc.dstW && pc.srcH == pc.dstH) {
            color = loadPx(dst);
        } else {
            color = sampleFsrEasu(srcPos);
        }
    } else if (pc.method == 3) {
        color = sampleLanczos(srcPos);
    } else if (pc.method == 4 || pc.method == 6 || pc.method == 7 ||
               pc.method == 8 || pc.method == 9 ||
               pc.method == 10 || pc.method == 11) {
        color = sampleBicubic(srcPos);
    } else {
        color = sampleBilinear(srcPos);
    }

    if (pc.method == 0) {
        color.rgb = fsrRcas(color.rgb, srcPos, sharp, strength);
    } else if (pc.method == 1 || pc.method == 2) {
        color.rgb = contrastAdaptive(color.rgb, srcPos, 0.55 * strength);
        color.rgb = sharpen(color.rgb, srcPos, 0.75 * sharp);
    } else if (pc.method == 8 || pc.method == 9 || pc.method == 10 || pc.method == 11) {
        color.rgb = animeEdge(color.rgb, srcPos, 0.55 * strength + 0.35 * sharp);
    } else if (pc.method == 12 || pc.method == 13) {
        color.rgb = sharpen(color.rgb, srcPos, 0.85 * sharp);
    } else if (pc.method == 14) {
        color.rgb = contrastAdaptive(color.rgb, srcPos, 0.85 * strength);
    } else if (pc.method == 15) {
        color.rgb = deband(color.rgb, srcPos, strength);
    }

    imageStore(dstImg, dst, clamp(color, 0.0, 1.0));
}
